#!/usr/bin/env -S uv run --quiet --with google-auth --with google-api-python-client --with requests --script
"""Prove DWD impersonation for two or more subjects, using the local SA key."""
import json
import sys
from pathlib import Path

from google.auth.transport.requests import Request
from google.auth.exceptions import RefreshError
from google.oauth2 import service_account
from googleapiclient.discovery import build

SA_KEY = Path("/Users/nascentech/.collevity/auth/_service/sa-key.json")

PROOF_SCOPES = [
    "https://www.googleapis.com/auth/calendar",
    "https://www.googleapis.com/auth/drive",
    "https://www.googleapis.com/auth/tasks",
]


def as_user(subject):
    try:
        creds = service_account.Credentials.from_service_account_file(
            str(SA_KEY), scopes=PROOF_SCOPES, subject=subject
        )
        creds.refresh(Request())
        return creds
    except RefreshError as e:
        payload = next((a for a in e.args if isinstance(a, dict)), {})
        sys.exit(f"exchange failed for {subject}: {payload.get('error_description') or e}")


def check(subject):
    print(f"\n=== impersonating {subject} ===")
    creds = as_user(subject)
    cal = build("calendar", "v3", credentials=creds, cache_discovery=False)
    cals = cal.calendarList().list(maxResults=5).execute().get("items", [])
    print(f"  calendars: {len(cals)} -> {[c.get('id') for c in cals][:3]}")
    drv = build("drive", "v3", credentials=creds, cache_discovery=False)
    me = drv.about().get(fields="user").execute()["user"]
    print(f"  drive identity: {me.get('emailAddress')}")
    got = (me.get("emailAddress") or "").lower()
    if got != subject.lower():
        sys.exit(f"  MISMATCH: acting as {got}, expected {subject}")
    print("  OK")


if __name__ == "__main__":
    subjects = sys.argv[1:]
    if len(subjects) < 2:
        sys.exit("usage: clv-dwd-verify <subject1> <subject2> [...]")
    if not SA_KEY.exists():
        sys.exit(f"missing SA key: {SA_KEY}")
    print("SA", json.loads(SA_KEY.read_text())["client_email"])
    print("auth: local key signing (no user credential)")
    for s in subjects:
        check(s)
    print("\nDWD verified for", len(subjects), "subjects.")

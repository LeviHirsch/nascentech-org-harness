#!/usr/bin/env -S uv run --quiet --with google-auth --with google-api-python-client --with requests --script
"""clv-dwd-health — walk the DWD chain bottom-up so a failure localises.

The chain, and what breaks it:

  1 key       SA key file present, well-formed   -> clv-dwd exits "missing SA key"
  2 sign      the key signs a JWT offline        -> bad or truncated private key
  3 scopes    per-scope DWD grant in Admin       -> 401 unauthorized_client
  4 subjects  subject resolves, API answers      -> invalid_grant / API 403
  5 write     create/delete round-trip           -> API 403 on insert

If the key file is missing, rungs 1-2 fall back to the legacy shape (mini@
refresh token -> signJwt). clv-dwd no longer has that path, so the run is
marked failed up front and the legacy rungs are diagnostic only.

Rungs 1-4 are read-only. Rung 5 (--write) creates real artifacts and deletes
them again; mail is trashed rather than purged, because purging needs the full
https://mail.google.com/ scope and trashing only needs gmail.modify.

  clv-dwd-health                       rungs 1-4
  clv-dwd-health --write               all five
  clv-dwd-health --subjects a@x,b@x    override the subject list
"""
from __future__ import annotations

import argparse
import base64
import io
import json
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from email.mime.text import MIMEText
from pathlib import Path

from google.auth.transport.requests import Request
from google.oauth2.credentials import Credentials
from google.oauth2 import service_account
from google.auth import crypt, jwt as gjwt
from google.auth.exceptions import RefreshError
from googleapiclient.discovery import build
from googleapiclient.errors import HttpError

HOME = Path("/Users/nascentech")
SA_META = HOME / ".collevity/auth/_service/sa.json"
USER_TOKEN = HOME / ".collevity/auth/tokens/mini@nascentech.com.json"
SA_KEY = HOME / ".collevity/auth/_service/sa-key.json"

# "key"   = SA signs its own JWTs locally. No user credential, nothing that
#           expires on a human-session clock. The target shape.
# "token" = legacy: mini@ user token -> signJwt -> exchange. Works, but dies
#           on the reauth clock, which is the whole reason for the migration.
MODE = "key" if SA_KEY.exists() else "token"

DEFAULT_SUBJECTS = [
    "levi@nascentech.com",
    "mini@nascentech.com",
    "sabrina@nascentech.com",
]
ADMIN_SUBJECT = "levi@nascentech.com"

B = "https://www.googleapis.com/auth/"

# The Admin DWD grant is a SET of exact strings. Google does NOT imply narrow
# scopes from broad ones at exchange time: if `drive` is granted and you ask for
# `drive.readonly`, the exchange fails. So a "not granted" narrow scope is only a
# real gap when nothing broader covers it — otherwise it just means "ask for the
# broad one instead". Test the broad set; report the narrow ones as covered.
BROAD_SCOPES = [
    ("gmail.modify", B + "gmail.modify"),
    ("gmail.send", B + "gmail.send"),
    ("drive", B + "drive"),
    ("calendar", B + "calendar"),
    ("tasks", B + "tasks"),
    ("spreadsheets", B + "spreadsheets"),
    ("documents", B + "documents"),
    ("contacts", B + "contacts"),
    ("admin.directory.user.readonly", B + "admin.directory.user.readonly"),
    ("cloud-identity.policies.readonly", B + "cloud-identity.policies.readonly"),
]

# narrow scope -> the broad scope that subsumes it
SUBSUMED = {
    B + "gmail.readonly": B + "gmail.modify",
    B + "gmail.labels": B + "gmail.modify",
    B + "gmail.compose": B + "gmail.modify",
    B + "drive.readonly": B + "drive",
    B + "drive.file": B + "drive",
    B + "calendar.readonly": B + "calendar",
    B + "calendar.events": B + "calendar",
    B + "tasks.readonly": B + "tasks",
    B + "spreadsheets.readonly": B + "spreadsheets",
    B + "documents.readonly": B + "documents",
    B + "contacts.readonly": B + "contacts",
}

# What each clv-dwd subcommand actually asks for. A grant gap only matters if it
# breaks one of these. Keep in step with clv-dwd: a command missing here is a
# command this check says nothing about.
_GMAIL, _DRIVE, _CAL = [B + "gmail.modify"], [B + "drive"], [B + "calendar"]
_TASKS, _SHEETS = [B + "tasks"], [B + "spreadsheets"]
CONSUMERS = {
    "as": [B + "gmail.modify", B + "drive"],
    "verify": [B + "gmail.modify", B + "drive"],
    "users": [B + "admin.directory.user.readonly"],
    "send": [B + "gmail.send"],
    **{c: _GMAIL for c in ("mail", "msg", "draft", "draft-delete", "labels", "label")},
    **{c: _CAL for c in ("event", "agenda", "calendars", "event-update", "event-delete")},
    **{c: _TASKS for c in ("task", "tasks", "task-done", "task-delete")},
    **{c: _DRIVE for c in ("files", "file", "copy", "mkdir", "upload", "update", "trash",
                           "export", "perms", "share", "unshare")},
    **{c: _SHEETS for c in ("sheet", "sheet-append", "sheet-write")},
}

OK = "PASS"
NO = "FAIL"
WARN = "WARN"

results: list[tuple[str, str, str]] = []


def record(rung: str, status: str, detail: str) -> None:
    results.append((rung, status, detail))
    mark = {OK: "  ok  ", NO: " FAIL ", WARN: " warn "}[status]
    print(f"[{mark}] {rung:<44} {detail}")


def http_err(e: urllib.error.HTTPError) -> tuple[int, dict, str]:
    raw = e.read().decode(errors="replace")
    try:
        return e.code, json.loads(raw), raw
    except Exception:
        return e.code, {}, raw


REFRESH_HINTS = {
    "invalid_rapt": (
        "Google Cloud session control expired the reauth proof.\n"
        "  The token carries cloud-platform scope, so it is governed by the\n"
        "  Workspace GCP session-length policy, not by the token's own lifetime.\n"
        "  A headless box cannot satisfy an interactive reauth, so this recurs\n"
        "  on the policy clock until the policy changes.\n"
        "  Fix: Admin console -> Security -> Access and data control ->\n"
        "  Google Cloud session control -> 'Session never expires' for the OU\n"
        "  holding mini@. Then re-mint the token once."
    ),
    "invalid_token": (
        "Refresh token revoked or superseded.\n"
        "  Someone re-ran the consent flow, revoked app access, or the account\n"
        "  password changed. Re-mint."
    ),
}
TESTING_HINT = (
    "If the OAuth consent screen is in Testing rather than In production,\n"
    "  refresh tokens expire after 7 days regardless of anything else.\n"
    "  Check the publishing status before re-minting."
)


def explain_refresh_failure(data: dict) -> None:
    """Re-issue the refresh bare so the error_subtype survives."""
    body = urllib.parse.urlencode(
        {
            "grant_type": "refresh_token",
            "refresh_token": data["refresh_token"],
            "client_id": data["client_id"],
            "client_secret": data["client_secret"],
        }
    ).encode()
    req = urllib.request.Request(
        "https://oauth2.googleapis.com/token", data=body, method="POST"
    )
    subtype = desc = ""
    try:
        urllib.request.urlopen(req).read()
        print("\n  Bare refresh succeeded on retry - transient. Re-run.")
        return
    except urllib.error.HTTPError as e:
        _, parsed, raw = http_err(e)
        subtype = parsed.get("error_subtype", "")
        desc = parsed.get("error_description", raw[:200])

    print(f"\n  error_subtype: {subtype or '(none)'}  |  {desc}")
    print("\n  " + REFRESH_HINTS.get(subtype, TESTING_HINT))
    print(
        "\n  NOTE: this is the legacy path, taken only because the SA key file is\n"
        "  missing. Re-minting this token lets the rest of this check run, but\n"
        "  clv-dwd does not use it: clv-dwd needs the key."
    )


# ------------------------------------------------------------------ rung 1 ---
def rung1_key() -> tuple[str, str]:
    """Validate the SA key locally. No network: that is the entire point."""
    print("\n=== rung 1: SA key (local, offline) ===")
    try:
        k = json.loads(SA_KEY.read_text())
    except Exception as e:
        record("1 key file readable", NO, f"{SA_KEY}: {e}")
        sys.exit(1)
    missing = [f for f in ("client_email", "private_key", "private_key_id", "project_id")
               if not k.get(f)]
    if missing:
        record("1 key file shape", NO, "missing " + ", ".join(missing))
        sys.exit(1)
    record("1 key file shape", OK, f"{k['project_id']} kid={k['private_key_id'][:12]}")

    mode = oct(SA_KEY.stat().st_mode & 0o777)
    record("1 key file perms", OK if mode == "0o600" else WARN,
           f"{mode}" + ("" if mode == "0o600" else " - want 0600"))

    expected = json.loads(SA_META.read_text())["email"]
    if k["client_email"] != expected:
        record("1 key identity", NO, f"{k['client_email']} != sa.json {expected}")
        sys.exit(1)
    record("1 key identity", OK, k["client_email"])
    record("1 no user credential", OK, "auth needs no mini@ token, no reauth clock")
    return "", k["client_email"]


def rung1_token() -> tuple[str, str]:
    """Refresh mini@ and prove the access token names a real identity."""
    print("\n=== rung 1: mini@ source credential (legacy shape) ===")
    try:
        data = json.loads(USER_TOKEN.read_text())
    except Exception as e:
        record("1 token file readable", NO, f"{USER_TOKEN}: {e}")
        sys.exit(1)

    creds = Credentials(
        token=data.get("token"),
        refresh_token=data.get("refresh_token"),
        token_uri=data.get("token_uri") or "https://oauth2.googleapis.com/token",
        client_id=data["client_id"],
        client_secret=data["client_secret"],
        scopes=data.get("scopes"),
    )
    try:
        creds.refresh(Request())
    except Exception as e:
        # google-auth flattens the useful part away, so ask the token endpoint
        # directly. invalid_grant has several subtypes and they want different
        # fixes; guessing between them costs an afternoon.
        record("1 refresh token alive", NO, str(e).splitlines()[0])
        explain_refresh_failure(data)
        sys.exit(1)
    record("1 refresh token alive", OK, "refreshed")

    req = urllib.request.Request(
        "https://www.googleapis.com/oauth2/v3/userinfo",
        headers={"Authorization": "Bearer " + creds.token},
    )
    try:
        with urllib.request.urlopen(req) as resp:
            info = json.loads(resp.read())
        record("1 token identity", OK, info.get("email", "?"))
    except urllib.error.HTTPError as e:
        code, _, raw = http_err(e)
        record("1 token identity", NO, f"HTTP {code} {raw[:120]}")

    granted = set(data.get("scopes") or [])
    if B + "cloud-platform" in granted:
        record("1 cloud-platform scope", OK, "present (needed for signJwt)")
    else:
        record("1 cloud-platform scope", NO, "absent - signJwt will 403")

    return creds.token, json.loads(SA_META.read_text())["email"]


# ------------------------------------------------------------------ rung 2 ---
def sign_jwt(source_token: str, sa: str, subject: str, scopes: list[str]) -> str:
    now = int(time.time())
    claim = {
        "iss": sa,
        "sub": subject,
        "aud": "https://oauth2.googleapis.com/token",
        "iat": now,
        "exp": now + 3600,
        "scope": " ".join(scopes),
    }
    url = (
        "https://iamcredentials.googleapis.com/v1/projects/-"
        f"/serviceAccounts/{sa}:signJwt"
    )
    req = urllib.request.Request(
        url,
        data=json.dumps({"payload": json.dumps(claim)}).encode(),
        method="POST",
        headers={
            "Authorization": "Bearer " + source_token,
            "Content-Type": "application/json",
        },
    )
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read())["signedJwt"]


def rung2_local_sign(sa: str) -> None:
    """Sign offline with the private key. Proves independence from IAM entirely."""
    print("\n=== rung 2: local JWT signing (no network, no IAM) ===")
    print(f"  SA {sa}")
    try:
        signer = crypt.RSASigner.from_service_account_file(str(SA_KEY))
        now = int(time.time())
        tok = gjwt.encode(signer, {
            "iss": sa, "sub": ADMIN_SUBJECT,
            "aud": "https://oauth2.googleapis.com/token",
            "iat": now, "exp": now + 600,
            "scope": B + "drive",
        })
        record("2 local sign", OK, f"signed offline, {len(tok)} bytes (not exchanged)")
        record("2 iamcredentials dependency", OK, "none - signJwt no longer in the path")
    except Exception as e:
        record("2 local sign", NO, f"{type(e).__name__}: {e}")
        sys.exit(1)


def rung2_signjwt(source_token: str, sa: str) -> None:
    """Sign but deliberately do not exchange - isolates IAM from the Admin grant."""
    print("\n=== rung 2: signJwt (IAM binding + API enablement) ===")
    print(f"  SA {sa}")
    try:
        jwt = sign_jwt(source_token, sa, ADMIN_SUBJECT, [B + "drive"])
        record("2 signJwt", OK, f"signed, {len(jwt)} chars (not exchanged)")
    except urllib.error.HTTPError as e:
        code, parsed, raw = http_err(e)
        reason = ""
        try:
            details = parsed["error"].get("details", [])
            for d in details:
                if d.get("reason"):
                    reason = d["reason"]
                    break
            if not reason:
                reason = parsed["error"].get("status", "")
        except Exception:
            pass
        if "SERVICE_DISABLED" in raw:
            record("2 signJwt", NO, f"HTTP {code} SERVICE_DISABLED")
            print(
                "\n  IAM Credentials API is off for the project. Enable\n"
                "  iamcredentials.googleapis.com and re-run."
            )
        elif code == 403:
            record("2 signJwt", NO, f"HTTP {code} {reason or 'PERMISSION_DENIED'}")
            print(
                "\n  mini@ is missing roles/iam.serviceAccountTokenCreator on the SA.\n"
                "  Grant it on the service account itself, not the project."
            )
        else:
            record("2 signJwt", NO, f"HTTP {code} {raw[:160]}")
        sys.exit(1)


# ------------------------------------------------------------------ rung 3 ---
def exchange(jwt: str) -> str:
    data = urllib.parse.urlencode(
        {
            "grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
            "assertion": jwt,
        }
    ).encode()
    req = urllib.request.Request(
        "https://oauth2.googleapis.com/token", data=data, method="POST"
    )
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read())["access_token"]


def token_for(source_token: str, sa: str, subject: str, scopes: list[str]) -> str:
    if MODE == "key":
        # google-auth does sign-then-exchange internally and raises RefreshError
        # where the legacy path raises HTTPError. Translate, so the dozen call
        # sites that already parse the token endpoint's JSON keep working and
        # the two modes stay diff-able.
        try:
            creds = service_account.Credentials.from_service_account_file(
                str(SA_KEY), scopes=scopes, subject=subject
            )
            creds.refresh(Request())
            return creds.token
        except RefreshError as e:
            payload = next((a for a in e.args if isinstance(a, dict)), None) or {
                "error": "unauthorized_client",
                "error_description": str(e.args[0] if e.args else e),
            }
            raise urllib.error.HTTPError(
                "https://oauth2.googleapis.com/token", 401, "Unauthorized", {},
                io.BytesIO(json.dumps(payload).encode()),
            ) from None
    return exchange(sign_jwt(source_token, sa, subject, scopes))


def rung3_scopes(source_token: str, sa: str, probe_subject: str) -> dict[str, bool]:
    """One exchange per scope string. This is the rung the old tools skip."""
    print(f"\n=== rung 3: per-scope DWD grant (probing as {probe_subject}) ===")
    granted: dict[str, bool] = {}
    for label, scope in BROAD_SCOPES:
        subject = ADMIN_SUBJECT if "admin.directory" in scope else probe_subject
        try:
            token_for(source_token, sa, subject, [scope])
            granted[scope] = True
            record(f"3 scope {label}", OK, "granted")
        except urllib.error.HTTPError as e:
            code, parsed, raw = http_err(e)
            err = parsed.get("error", "")
            desc = parsed.get("error_description", raw[:100])
            granted[scope] = False
            if err == "unauthorized_client":
                record(f"3 scope {label}", NO, "not in the Admin DWD grant")
            elif err == "invalid_grant":
                record(f"3 scope {label}", NO, f"invalid_grant ({desc})")
            else:
                record(f"3 scope {label}", NO, f"HTTP {code} {err} {desc}")

    ok = sum(1 for v in granted.values() if v)
    print(f"\n  {ok}/{len(BROAD_SCOPES)} broad scopes granted.")

    print("\n  narrow variants (not granted directly - use the broad one):")
    for narrow, broad in sorted(SUBSUMED.items()):
        state = "covered by " + broad.rsplit("/", 1)[1] if granted.get(broad) else "NO COVER"
        print(f"    {narrow.rsplit('/', 1)[1]:<26} {state}")

    print("\n  consumer readiness:")
    broken = 0
    for name, needs in CONSUMERS.items():
        missing = [n.rsplit("/", 1)[1] for n in needs if not granted.get(n)]
        if missing:
            broken += 1
            record(f"3 consumer clv-dwd {name}", NO, "missing " + ", ".join(missing))
    if not broken:
        record("3 consumers", OK, f"all {len(CONSUMERS)} clv-dwd commands have their scopes")
    return granted


# ------------------------------------------------------------------ rung 4 ---
def rung4_subjects(source_token: str, sa: str, subjects: list[str]) -> list[str]:
    """Identity echo per subject. Read-only."""
    print("\n=== rung 4: subject impersonation (read-only) ===")
    alive: list[str] = []
    for subject in subjects:
        try:
            # Use the BROAD scopes - the narrow ones are not in the grant.
            tok = token_for(source_token, sa, subject, [B + "drive", B + "calendar"])
        except urllib.error.HTTPError as e:
            _, parsed, raw = http_err(e)
            desc = parsed.get("error_description") or raw[:120]
            record(f"4 {subject} exchange", NO, desc)
            continue

        creds = Credentials(token=tok)
        try:
            drv = build("drive", "v3", credentials=creds, cache_discovery=False)
            who = drv.about().get(fields="user").execute()["user"]
            got = (who.get("emailAddress") or "").lower()
            if got == subject.lower():
                record(f"4 {subject} drive identity", OK, who.get("displayName") or got)
                alive.append(subject)
            else:
                record(f"4 {subject} drive identity", NO, f"acting as {got}")
                continue
        except HttpError as e:
            record(f"4 {subject} drive identity", NO, f"HTTP {e.resp.status}")
            continue

        try:
            cal = build("calendar", "v3", credentials=creds, cache_discovery=False)
            cals = cal.calendarList().list(maxResults=50).execute().get("items", [])
            record(f"4 {subject} calendar list", OK, f"{len(cals)} calendars")
        except HttpError as e:
            record(f"4 {subject} calendar list", WARN, f"HTTP {e.resp.status}")
    return alive


def rung4_directory(source_token: str, sa: str, granted: dict[str, bool]) -> None:
    scope = B + "admin.directory.user.readonly"
    if not granted.get(scope):
        record("4 directory listing", WARN, "skipped - scope not granted")
        return
    try:
        tok = token_for(source_token, sa, ADMIN_SUBJECT, [scope])
        d = build("admin", "directory_v1", credentials=Credentials(token=tok),
                  cache_discovery=False)
        users = (
            d.users().list(customer="my_customer", maxResults=200, orderBy="email")
            .execute().get("users", [])
        )
        emails = [u.get("primaryEmail") for u in users]
        record("4 directory listing", OK, f"{len(users)} users: {', '.join(emails)}")
    except HttpError as e:
        record("4 directory listing", NO, f"HTTP {e.resp.status}")
    except urllib.error.HTTPError as e:
        _, parsed, raw = http_err(e)
        record("4 directory listing", NO, parsed.get("error_description") or raw[:120])


# ------------------------------------------------------------------ rung 5 ---
STAMP = time.strftime("%Y%m%d-%H%M%S")
TAG = f"clv-dwd-health {STAMP}"


def probe_task(source_token: str, sa: str, subject: str) -> None:
    try:
        tok = token_for(source_token, sa, subject, [B + "tasks"])
        api = build("tasks", "v1", credentials=Credentials(token=tok),
                    cache_discovery=False)
        t = api.tasks().insert(tasklist="@default", body={"title": TAG}).execute()
    except HttpError as e:
        record(f"5 {subject} task insert", NO, f"HTTP {e.resp.status}")
        return
    except urllib.error.HTTPError as e:
        _, parsed, raw = http_err(e)
        record(f"5 {subject} task insert", NO, parsed.get("error_description") or raw[:100])
        return
    record(f"5 {subject} task insert", OK, t.get("id", "")[:20])
    try:
        api.tasks().delete(tasklist="@default", task=t["id"]).execute()
        record(f"5 {subject} task cleanup", OK, "deleted")
    except HttpError as e:
        record(f"5 {subject} task cleanup", NO, f"HTTP {e.resp.status} - LEFTOVER {t['id']}")


def probe_event(source_token: str, sa: str, subject: str) -> None:
    start = time.gmtime(time.time() + 86400 * 400)
    s = time.strftime("%Y-%m-%dT%H:00:00", start)
    e_ = time.strftime("%Y-%m-%dT%H:30:00", start)
    try:
        tok = token_for(source_token, sa, subject, [B + "calendar"])
        api = build("calendar", "v3", credentials=Credentials(token=tok),
                    cache_discovery=False)
        ev = api.events().insert(
            calendarId="primary",
            body={
                "summary": TAG,
                "start": {"dateTime": s, "timeZone": "America/New_York"},
                "end": {"dateTime": e_, "timeZone": "America/New_York"},
                "transparency": "transparent",
                "visibility": "private",
            },
        ).execute()
    except HttpError as ex:
        record(f"5 {subject} event insert", NO, f"HTTP {ex.resp.status}")
        return
    except urllib.error.HTTPError as ex:
        _, parsed, raw = http_err(ex)
        record(f"5 {subject} event insert", NO, parsed.get("error_description") or raw[:100])
        return
    record(f"5 {subject} event insert", OK, f"{s} id={ev.get('id','')[:16]}")
    try:
        api.events().delete(calendarId="primary", eventId=ev["id"]).execute()
        record(f"5 {subject} event cleanup", OK, "deleted")
    except HttpError as ex:
        record(f"5 {subject} event cleanup", NO,
               f"HTTP {ex.resp.status} - LEFTOVER {ev['id']}")


def probe_draft(source_token: str, sa: str, subject: str) -> None:
    """Draft create/delete: exercises the gmail write path with zero delivery."""
    try:
        tok = token_for(source_token, sa, subject, [B + "gmail.modify"])
        api = build("gmail", "v1", credentials=Credentials(token=tok),
                    cache_discovery=False)
        msg = MIMEText(TAG, "plain", "utf-8")
        msg["to"] = subject
        msg["from"] = subject
        msg["subject"] = TAG
        raw = base64.urlsafe_b64encode(msg.as_bytes()).decode()
        d = api.users().drafts().create(userId="me", body={"message": {"raw": raw}}).execute()
    except HttpError as e:
        record(f"5 {subject} gmail draft", NO, f"HTTP {e.resp.status}")
        return
    except urllib.error.HTTPError as e:
        _, parsed, rawb = http_err(e)
        record(f"5 {subject} gmail draft", NO, parsed.get("error_description") or rawb[:100])
        return
    record(f"5 {subject} gmail draft", OK, d.get("id", "")[:20])
    try:
        api.users().drafts().delete(userId="me", id=d["id"]).execute()
        record(f"5 {subject} draft cleanup", OK, "deleted")
    except HttpError as e:
        record(f"5 {subject} draft cleanup", NO,
               f"HTTP {e.resp.status} - LEFTOVER draft {d['id']}")


def probe_send(source_token: str, sa: str, subject: str) -> None:
    """Real send, subject to themselves, then trash both copies."""
    try:
        tok = token_for(source_token, sa, subject, [B + "gmail.send"])
        send_api = build("gmail", "v1", credentials=Credentials(token=tok),
                         cache_discovery=False)
        msg = MIMEText(
            "Automated DWD health probe. Safe to ignore; this thread is trashed "
            "automatically.\n\n" + TAG, "plain", "utf-8")
        msg["to"] = subject
        msg["from"] = subject
        msg["subject"] = TAG
        raw = base64.urlsafe_b64encode(msg.as_bytes()).decode()
        sent = send_api.users().messages().send(userId="me", body={"raw": raw}).execute()
    except HttpError as e:
        record(f"5 {subject} gmail send", NO, f"HTTP {e.resp.status}")
        return
    except urllib.error.HTTPError as e:
        _, parsed, rawb = http_err(e)
        record(f"5 {subject} gmail send", NO, parsed.get("error_description") or rawb[:100])
        return
    record(f"5 {subject} gmail send", OK, f"thread={sent.get('threadId','')[:16]}")

    # Cleanup needs gmail.modify; send alone cannot trash.
    try:
        tok2 = token_for(source_token, sa, subject, [B + "gmail.modify"])
        mod = build("gmail", "v1", credentials=Credentials(token=tok2),
                    cache_discovery=False)
    except urllib.error.HTTPError:
        record(f"5 {subject} send cleanup", NO,
               f"gmail.modify unavailable - LEFTOVER thread {sent.get('threadId')}")
        return

    # A self-addressed probe collapses to ONE message id carrying both SENT and
    # INBOX - not two. Track ids in a set so a retry cannot double-count the
    # same message, which is what made this report "2 trashed" for one message.
    done: set[str] = set()
    for _ in range(4):
        try:
            th = mod.users().threads().get(userId="me", id=sent["threadId"]).execute()
            ids = {m["id"] for m in th.get("messages", [])}
        except HttpError:
            ids = {sent["id"]}
        for mid in ids - done:
            try:
                mod.users().messages().trash(userId="me", id=mid).execute()
                done.add(mid)
            except HttpError:
                pass
        if done:
            break
        time.sleep(2)
    trashed = len(done)
    if trashed:
        record(f"5 {subject} send cleanup", OK,
               f"{trashed} message(s) trashed (in Trash 30d, not purged)")
    else:
        record(f"5 {subject} send cleanup", NO,
               f"LEFTOVER thread {sent.get('threadId')}")


def rung5_write(source_token: str, sa: str, subjects: list[str]) -> None:
    print("\n=== rung 5: write round-trip (creates then deletes) ===")
    print(f"  tag: {TAG}")
    for subject in subjects:
        probe_task(source_token, sa, subject)
        probe_event(source_token, sa, subject)
        probe_draft(source_token, sa, subject)
        probe_send(source_token, sa, subject)


# -------------------------------------------------------------------- main ---
def main() -> None:
    p = argparse.ArgumentParser(prog="clv-dwd-health")
    p.add_argument("--subjects", default=",".join(DEFAULT_SUBJECTS))
    p.add_argument("--write", action="store_true",
                   help="run rung 5 (creates real artifacts, deletes them after)")
    args = p.parse_args()
    subjects = [s.strip() for s in args.subjects.split(",") if s.strip()]

    print(f"clv-dwd-health  {time.strftime('%Y-%m-%d %H:%M:%S %Z')}")
    print(f"subjects: {', '.join(subjects)}")

    print(f"mode: {MODE}" + ("  (SA key present)" if MODE == "key"
                             else "  (legacy mini@ token - expires on reauth clock)"))
    if MODE == "key":
        source_token, sa = rung1_key()
        rung2_local_sign(sa)
    else:
        # clv-dwd has no token path any more, so a missing key means it is down
        # whatever the rungs below say about the legacy chain.
        record("0 SA key present", NO, f"{SA_KEY} missing - clv-dwd cannot run without it")
        source_token, sa = rung1_token()
        rung2_signjwt(source_token, sa)
    granted = rung3_scopes(source_token, sa, subjects[0])
    alive = rung4_subjects(source_token, sa, subjects)
    rung4_directory(source_token, sa, granted)
    if args.write:
        rung5_write(source_token, sa, alive)
    else:
        print("\n=== rung 5: skipped (pass --write) ===")

    fails = [r for r in results if r[1] == NO]
    warns = [r for r in results if r[1] == WARN]
    print("\n" + "=" * 68)
    print(f"{len(results) - len(fails) - len(warns)} pass  {len(warns)} warn  {len(fails)} fail")
    for rung, _, detail in fails:
        print(f"  FAIL  {rung}: {detail}")
    for rung, _, detail in warns:
        print(f"  warn  {rung}: {detail}")
    sys.exit(1 if fails else 0)


if __name__ == "__main__":
    main()
